{
  "name": "twenty-cli",
  "version": "0.1.0",
  "description": "Agent-ready CLI for Twenty CRM REST API: people, companies, opportunities, notes, tasks. Cloud & self-hosted.",
  "type": "module",
  "bin": {
    "twenty-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "keywords": [
    "twenty",
    "crm",
    "cli",
    "api",
    "salesforce-alternative",
    "api2cli",
    "agent-skill",
    "self-hosted"
  ],
  "license": "MIT",
  "author": "Nardjo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nardjo/twenty-cli.git"
  },
  "homepage": "https://github.com/Nardjo/twenty-cli#readme",
  "bugs": {
    "url": "https://github.com/Nardjo/twenty-cli/issues"
  },
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target bun",
    "dev": "bun run src/index.ts"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
